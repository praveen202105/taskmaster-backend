NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskmaster:taskmaster@localhost:5432/taskmaster?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=taskmaster_refresh
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=0
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_BYTES=10485760
ALLOWED_ATTACHMENT_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
SEED_PASSWORD=TaskMasterDemo123!
