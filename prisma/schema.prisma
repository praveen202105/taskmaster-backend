generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(320)
  passwordHash      String             @map("password_hash")
  name              String             @db.VarChar(120)
  avatarUrl         String?            @map("avatar_url") @db.VarChar(2048)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions   RefreshSession[]
  ownedTeams        Team[]             @relation("TeamOwner")
  memberships       TeamMember[]
  sentInvitations   TeamInvitation[]   @relation("InvitationSender")
  acceptedInvites   TeamInvitation[]   @relation("InvitationAcceptor")
  createdProjects   Project[]
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     Task[]             @relation("TaskAssignee")
  comments          Comment[]
  attachments       Attachment[]

  @@map("users")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy  String?   @map("replaced_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(1000)
  ownerId     String           @map("owner_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     TeamMember[]
  invitations TeamInvitation[]
  projects    Project[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  teamId       String           @map("team_id") @db.Uuid
  email        String           @db.VarChar(320)
  role         TeamRole         @default(MEMBER)
  status       InvitationStatus @default(PENDING)
  invitedById  String           @map("invited_by_id") @db.Uuid
  acceptedById String?          @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([teamId, status])
  @@map("team_invitations")
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  teamId      String       @map("team_id") @db.Uuid
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(2000)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@unique([teamId, name])
  @@index([createdById])
  @@map("projects")
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  title        String       @db.VarChar(200)
  description  String       @db.VarChar(5000)
  dueDate      DateTime     @map("due_date") @db.Timestamptz(3)
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(MEDIUM)
  createdById  String       @map("created_by_id") @db.Uuid
  assigneeId   String?      @map("assignee_id") @db.Uuid
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     Comment[]
  attachments  Attachment[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([createdAt])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(127)
  size         Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([uploadedById])
  @@map("attachments")
}
